{
  "name": "@proctor/voice-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoiceHire cloud voice agent (LiveKit Cloud). Runs remotely - never on the kiosk.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts dev",
