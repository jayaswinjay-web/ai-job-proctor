# ============================================================================
# AI Job Screening & Proctoring Platform — environment configuration
# Copy to `.env` and adjust. NEVER commit a filled-in `.env`.
# Every value below has a safe default except DATABASE_URL and AUTH_SECRET.
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- Database --------------------------------------------------------------
DATABASE_URL="postgresql://proctor:proctor_dev_password@localhost:5432/proctor?schema=public"

# ---- HTTP ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
BODY_LIMIT_BYTES=2097152

# ---- Authentication --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters-000000000000"
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_HOURS=12
AUTH_COOKIE_NAME=proctor_rt
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCKOUT_MINUTES=15
AUTH_REQUIRE_TOTP=false
# Used only by the seed script. Leave blank to have a password generated + printed once.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Demo mode -------------------------------------------------------------
# true  -> every AI provider is a local deterministic mock, zero network calls.
# false -> real providers are used according to the settings below.
DEMO_MODE=true

# ---- LiveKit Cloud voice (thin-client architecture) ------------------------
# The production interview runs over LiveKit Cloud with a remote AI voice agent.
# The kiosk is only an audio terminal. Create a project at https://cloud.livekit.io
# and copy the URL, API key and secret here. The secret is used SERVER-SIDE ONLY to
# sign short-lived kiosk tokens; it is never sent to the browser.
#
# VOICE_MODE=livekit  -> cloud voice agent (production)
# VOICE_MODE=browser  -> legacy in-browser speech pipeline (development only)
VOICE_MODE=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=15
# Must match the agent name registered by the cloud voice agent worker.
VOICE_AGENT_NAME=voicehire-interview
# Shared secret the cloud agent presents on its callback API calls. Server-side only.
AGENT_API_KEY=
# Allow the legacy browser pipeline when LiveKit is not configured (development only).
ALLOW_BROWSER_VOICE_FALLBACK=false
# Language the voice agent opens in. Tamil is the primary experience.
VOICE_DEFAULT_LANGUAGE=ta

# ---- AI providers ----------------------------------------------------------
# Leave AI_API_KEY blank in demo mode. Keys are read server-side only and are
# never exposed to the browser bundle.
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# LLM_PROVIDER: mock | openai | openai-compatible | anthropic | ollama
LLM_PROVIDER=mock
# STT_PROVIDER: browser | mock | openai | whisper-http | deepgram
#   browser = Web Speech API in the kiosk (no key, works offline, audio stays local)
STT_PROVIDER=browser
# TTS_PROVIDER: browser | mock | openai | elevenlabs | google
TTS_PROVIDER=browser

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1400
EVALUATION_MODEL=gpt-4o-mini
EVALUATION_TEMPERATURE=0.1
# EVALUATION_PROVIDER: rules | llm | hybrid   (hybrid = deterministic rubric + model refinement)
EVALUATION_PROVIDER=hybrid

# ---- Object storage --------------------------------------------------------
# STORAGE_DRIVER=local writes to LOCAL_STORAGE_PATH (zero setup).
# STORAGE_DRIVER=s3 requires any S3-compatible endpoint (AWS, MinIO, R2, Spaces).
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=proctor-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ---- Session & retention ---------------------------------------------------
SESSION_TIMEOUT_MINUTES=30
KIOSK_RESET_DELAY_SECONDS=20
RECORDING_RETENTION_DAYS=90
TRANSCRIPT_RETENTION_DAYS=365
CANDIDATE_DATA_RETENTION_DAYS=365
SIGNED_URL_TTL_SECONDS=300

# ---- Voice -----------------------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,mr,ta
DEFAULT_LANGUAGE=en
FALLBACK_LANGUAGE=en
TTS_RATE=0.92
TTS_PITCH=1.0
TTS_VOLUME=1.0
TTS_SLOW_RATE=0.68
STT_SILENCE_TIMEOUT_SECONDS=6
STT_MAX_ANSWER_SECONDS=120
STT_MIN_CONFIDENCE=0.35
VAD_SILENCE_THRESHOLD_MS=1200
VAD_MAX_SILENCE_MS=12000
BARGE_IN_ENABLED=true

# ---- Interview -------------------------------------------------------------
INTERVIEW_RETRY_LIMIT=2
INTERVIEW_MAX_DURATION_MINUTES=45
FOLLOW_UP_MODE=LIMITED
MAX_FOLLOW_UPS_PER_QUESTION=1

# ---- Scoring ---------------------------------------------------------------
SCORING_STRICTNESS=BALANCED
DEFAULT_PASSING_SCORE=60
SCORING_CONFIDENCE_FLOOR=0.4
REQUIRE_HUMAN_REVIEW_BELOW_CONFIDENCE=0.4
AUTO_RECOMMEND=true

# ---- Proctoring ------------------------------------------------------------
# DISABLED | BASIC | STANDARD | ENHANCED
PROCTOR_LEVEL=BASIC
PROCTOR_CAMERA_ENABLED=false

# ---- Privacy ---------------------------------------------------------------
PRIVACY_NOTICE_REQUIRED=true
JURISDICTION_NOTE="Retention periods are configurable per deployment. Confirm local labour, recording and data-protection law with counsel before production use."
# Set to a stable random value; changing it invalidates historical IP-hash lookups.
IP_HASH_SALT=

# ---- Kiosk -----------------------------------------------------------------
KIOSK_ID=default
KIOSK_ENFORCE_FULLSCREEN=false

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---- Observability ---------------------------------------------------------
SENTRY_DSN=
HEALTHCHECK_PATH=/healthz